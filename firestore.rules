// Firestore security rules for Snow Leopard World cloud saves (see src/cloud.js).
// Paste into Firebase console > Firestore Database > Rules and publish.
//
// Each player can only read and write their own document, players/{their uid}.
// Writes must bump `rev` by exactly one, so two phones can't overwrite each
// other's progress without merging first.
//
// Note: players can still edit their own save (as with any offline game), so
// before selling Snow Crystals, grant purchased Crystals from a server
// (e.g. a RevenueCat webhook + Cloud Function) rather than trusting the app.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['schema', 'rev', 'profile', 'leopard', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.rev is int
        && request.resource.data.rev == (resource == null ? 1 : resource.data.rev + 1)
        && request.resource.data.profile is string
        && request.resource.data.profile.size() < 50000
        && request.resource.data.leopard is string
        && request.resource.data.leopard.size() < 10000
        && request.resource.data.updatedAt == request.time;

      // Players can delete their own cloud save (Google Play requires account deletion)
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Error reports from the game (src/errors.js). Anyone may add one, nobody can read,
    // change or delete them from the app; read them in the Firebase console.
    match /errorReports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'message', 'stack', 'where', 'version', 'platform', 'userAgent', 'gpu', 'safeRender', 'at'])
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 40
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 3000
        && request.resource.data.where is string && request.resource.data.where.size() <= 300
        && request.resource.data.version is string && request.resource.data.version.size() <= 40
        && request.resource.data.platform is string && request.resource.data.platform.size() <= 20
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300
        && request.resource.data.gpu is string && request.resource.data.gpu.size() <= 200
        && request.resource.data.safeRender is bool
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }
  }
}
