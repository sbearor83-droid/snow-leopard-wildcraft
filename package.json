{
  "name": "snow-leopard-wildcraft",
  "version": "1.0.0",
  "private": true,
  "description": "3D snow leopard hunting game for web and Android (Three.js + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "android": "vite build && npx cap sync android",
    "icons": "capacitor-assets generate --android --iconBackgroundColor '#16325a' --iconBackgroundColorDark '#16325a' --splashBackgroundColor '#0d1520' --splashBackgroundColorDark '#0d1520' && rm -rf android/app/src/main/res/drawable-*night*"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "vite": "^8.3.4"
  }
}
